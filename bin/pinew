#!/bin/zsh
# Create a new project under PIDEV_CODING_ROOT (mkdir + git init) and start pidev
[[ -n "$1" ]] || { echo "Usage: pinew <name>" >&2; exit 1; }
[[ -f "${0:A:h:h}/.env" ]] && { set -a; source "${0:A:h:h}/.env"; set +a; }
dir="${PIDEV_CODING_ROOT:?set PIDEV_CODING_ROOT in pidev/.env}/$1"
mkdir -p "$dir" && git -C "$dir" init -q
exec "${0:A:h}/pidev" "$dir"
