# pidev configuration. bin/pidev copies this to .env on first run (.env is not in git).

# Folder that contains your projects; pidev only runs on folders below it
PIDEV_CODING_ROOT="$HOME/Coding"

# OpenAI-compatible LLM endpoint (e.g. vLLM) and model ID (curl http://HOST:PORT/v1/models)
PIDEV_LLM_HOST=192.168.1.100
PIDEV_LLM_PORT=8000
PIDEV_LLM_MODEL=nvidia/Qwen3.8-Flash-Next-FP4-Local

# SearXNG secret key (generated by bin/pidev on first run)
SEARXNG_SECRET=
